    <geom name="stair_down_1" type="box" pos="3.55 0 0.15" size="0.15 0.5 0.15" material="stair_obstacle" friction="0.8 0.02 0.01" condim="6"/>
    <geom name="stair_down_2" type="box" pos="3.85 0 0.10" size="0.15 0.5 0.10" material="stair_obstacle" friction="0.8 0.02 0.01" condim="6"/>
    <geom name="stair_down_3" type="box" pos="4.15 0 0.05" size="0.15 0.5 0.05" material="stair_obstacle" friction="0.8 0.02 0.01" condim="6"/>
  </worldbody>
</mujoco>
